<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

<xacro:macro name="openarm_bimanual_ros2_control"
         params="arm_type
             left_can_interface:=^|can1
             right_can_interface:=^|can0
             use_fake_hardware:=^|false
             use_mujoco:=^|false
             fake_sensor_commands:=^|false
             hand:=^|false
             left_arm_prefix:=^|left_
             right_arm_prefix:=^|right_
             can_fd:=^|true
             mujoco_viewer:=^|false">

    <!-- Left Arm Hardware Interface -->
    <ros2_control name="openarm_left_hardware_interface" type="system">
        <hardware>
          <param name="arm_type">${arm_type}</param>

          <!-- MuJoCo Physics Simulation -->
          <xacro:if value="${use_mujoco}">
            <plugin>mujoco_ros2_control/MujocoSystem</plugin>
            <!-- Select model with or without hands based on hand parameter -->
            <xacro:if value="${hand}">
              <param name="mujoco_model">mujoco_models/openarm_${arm_type}_bimanual_hand.xml</param>
            </xacro:if>
            <xacro:unless value="${hand}">
            <param name="mujoco_model">mujoco_models/openarm_${arm_type}_bimanual.xml</param>
            </xacro:unless>
            <param name="mujoco_model_package">openarm_description</param>
            <!-- Left arm is "primary" and owns the MuJoCo viewer (GLFW can only init once).
                 Must output lowercase "true"/"false" for mujoco_ros2_control C++ plugin. -->
            <xacro:if value="${mujoco_viewer}">
              <param name="mujoco_viewer">true</param>
            </xacro:if>
            <xacro:unless value="${mujoco_viewer}">
              <param name="mujoco_viewer">false</param>
            </xacro:unless>
          </xacro:if>

          <!-- Fake Hardware (Mock Interface) -->
          <xacro:if value="${use_fake_hardware and not use_mujoco}">
            <plugin>fake_components/GenericSystem</plugin>
            <param name="fake_sensor_commands">${fake_sensor_commands}</param>
            <param name="state_following_offset">0.0</param>
          </xacro:if>

          <!-- Real Hardware (CAN Bus) -->
          <xacro:if value="${not use_fake_hardware and not use_mujoco}">
            <plugin>openarm_hardware/OpenArm_v10HW</plugin>
            <param name="can_interface">${left_can_interface}</param>
            <param name="arm_prefix">${left_arm_prefix}</param>
            <param name="hand">${hand}</param>
            <param name="can_fd">${can_fd}</param>
          </xacro:if>
        </hardware>

      <xacro:macro name="configure_joint" params="joint_name initial_position kp:=2000.0 kd:=100.0">
        <joint name="${joint_name}">
          <!-- PID parameters for both MuJoCo and real hardware -->
          <!-- These are used by: -->
          <!--   - mujoco_system.cpp (when use_mujoco=true) -->
          <!--   - zordi_ros_controllers software PD mode (compute_pd_internally=true) -->
          <!--   - real hardware interfaces (DAMIAO, etc.) -->
          <!-- CRITICAL: Must be outside conditional blocks so software PD mode always works -->
          <param name="position_kp">${kp}</param>
          <param name="position_kd">${kd}</param>
          <param name="position_ki">0.0</param>
          <!-- velocity_kp acts as damping gain (Kd) in MIT mode -->
          <param name="velocity_kp">${kd}</param>
          <param name="velocity_kd">0.0</param>
          <param name="velocity_ki">0.0</param>

          <!-- Command Interfaces -->
          <!-- ALWAYS expose standard interface names (same for real, fake, and MuJoCo) -->
          <command_interface name="position"/>
          <command_interface name="velocity"/>
          <command_interface name="effort"/>
          <!-- MIT mode: dynamic kp/kd gains sent to hardware each control cycle -->
          <command_interface name="kp"/>
          <command_interface name="kd"/>
          <!-- Safety limits for MIT mode gains -->
          <param name="max_kp">500.0</param>
          <param name="max_kd">50.0</param>

          <state_interface name="position">
            <param name="initial_value">${initial_position}</param>
          </state_interface>

          <state_interface name="velocity">
            <param name="initial_value">0.0</param>
          </state_interface>

          <state_interface name="effort">
            <param name="initial_value">0.0</param>
          </state_interface>
        </joint>
      </xacro:macro>

      <!-- Higher gains for proximal joints (1-4) that support more weight -->
      <xacro:configure_joint joint_name="openarm_${left_arm_prefix}joint1" initial_position="0.0" kp="3000.0" kd="150.0"/>
      <xacro:configure_joint joint_name="openarm_${left_arm_prefix}joint2" initial_position="0.0" kp="5000.0" kd="200.0"/>
      <xacro:configure_joint joint_name="openarm_${left_arm_prefix}joint3" initial_position="0.0" kp="3000.0" kd="150.0"/>
      <xacro:configure_joint joint_name="openarm_${left_arm_prefix}joint4" initial_position="0.0" kp="5000.0" kd="200.0"/>
      <!-- Lower gains for distal joints (5-7) with less inertia -->
      <xacro:configure_joint joint_name="openarm_${left_arm_prefix}joint5" initial_position="0.0" kp="1000.0" kd="50.0"/>
      <xacro:configure_joint joint_name="openarm_${left_arm_prefix}joint6" initial_position="0.0" kp="500.0" kd="30.0"/>
      <xacro:configure_joint joint_name="openarm_${left_arm_prefix}joint7" initial_position="0.0" kp="500.0" kd="30.0"/>

      <xacro:if value="${hand}">
        <xacro:configure_joint joint_name="openarm_${left_arm_prefix}finger_joint1" initial_position="0.0" />
      </xacro:if>
    </ros2_control>

    <!-- Right Arm Hardware Interface -->
    <ros2_control name="openarm_right_hardware_interface" type="system">
        <hardware>
          <param name="arm_type">${arm_type}</param>

          <!-- MuJoCo Physics Simulation -->
          <xacro:if value="${use_mujoco}">
            <plugin>mujoco_ros2_control/MujocoSystem</plugin>
            <!-- Select model with or without hands based on hand parameter -->
            <xacro:if value="${hand}">
              <param name="mujoco_model">mujoco_models/openarm_${arm_type}_bimanual_hand.xml</param>
            </xacro:if>
            <xacro:unless value="${hand}">
            <param name="mujoco_model">mujoco_models/openarm_${arm_type}_bimanual.xml</param>
            </xacro:unless>
            <param name="mujoco_model_package">openarm_description</param>
            <!-- IMPORTANT: Only ONE hardware interface can enable the viewer (GLFW limitation).
                 The left arm is the "primary" and owns the viewer; right arm is always headless. -->
            <param name="mujoco_viewer">false</param>
          </xacro:if>

          <!-- Fake Hardware (Mock Interface) -->
          <xacro:if value="${use_fake_hardware and not use_mujoco}">
            <plugin>fake_components/GenericSystem</plugin>
            <param name="fake_sensor_commands">${fake_sensor_commands}</param>
            <param name="state_following_offset">0.0</param>
          </xacro:if>

          <!-- Real Hardware (CAN Bus) -->
          <xacro:if value="${not use_fake_hardware and not use_mujoco}">
            <plugin>openarm_hardware/OpenArm_v10HW</plugin>
            <param name="can_interface">${right_can_interface}</param>
            <param name="arm_prefix">${right_arm_prefix}</param>
            <param name="hand">${hand}</param>
            <param name="can_fd">${can_fd}</param>
          </xacro:if>
        </hardware>

      <!-- Higher gains for proximal joints (1-4) that support more weight -->
      <xacro:configure_joint joint_name="openarm_${right_arm_prefix}joint1" initial_position="0.0" kp="3000.0" kd="150.0"/>
      <xacro:configure_joint joint_name="openarm_${right_arm_prefix}joint2" initial_position="0.0" kp="5000.0" kd="200.0"/>
      <xacro:configure_joint joint_name="openarm_${right_arm_prefix}joint3" initial_position="0.0" kp="3000.0" kd="150.0"/>
      <xacro:configure_joint joint_name="openarm_${right_arm_prefix}joint4" initial_position="0.0" kp="5000.0" kd="200.0"/>
      <!-- Lower gains for distal joints (5-7) with less inertia -->
      <xacro:configure_joint joint_name="openarm_${right_arm_prefix}joint5" initial_position="0.0" kp="1000.0" kd="50.0"/>
      <xacro:configure_joint joint_name="openarm_${right_arm_prefix}joint6" initial_position="0.0" kp="500.0" kd="30.0"/>
      <xacro:configure_joint joint_name="openarm_${right_arm_prefix}joint7" initial_position="0.0" kp="500.0" kd="30.0"/>

      <xacro:if value="${hand}">
        <xacro:configure_joint joint_name="openarm_${right_arm_prefix}finger_joint1" initial_position="0.0" />
      </xacro:if>
    </ros2_control>

  </xacro:macro>

</robot>
