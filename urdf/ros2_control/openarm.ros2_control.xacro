<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

<xacro:macro name="openarm_arm_ros2_control"
         params="arm_type
             can_interface
             use_fake_hardware:=^|false
                   use_mujoco:=^|false
             fake_sensor_commands:=^|false
             hand:=^|false
             gazebo_effort:=^|false
             arm_prefix:=''
             bimanual:=false
             can_fd:=^|true">

    <ros2_control name="openarm_hardware_interface" type="system">
        <hardware>
          <param name="arm_type">${arm_type}</param>
          <param name="prefix">${arm_prefix}</param>

          <!-- MuJoCo Physics Simulation -->
          <xacro:if value="${use_mujoco}">
            <plugin>mujoco_ros2_control/MujocoSystem</plugin>
            <!-- No control_mode parameter - mode switches automatically based on active controller -->
          </xacro:if>

          <!-- Fake Hardware (Mock Interface) -->
          <xacro:if value="${use_fake_hardware and not use_mujoco}">
            <plugin>fake_components/GenericSystem</plugin>
            <param name="fake_sensor_commands">${fake_sensor_commands}</param>
            <param name="state_following_offset">0.0</param>
          </xacro:if>

          <!-- Real Hardware (CAN Bus) -->
          <xacro:if value="${not use_fake_hardware and not use_mujoco}">
            <plugin>openarm_hardware/OpenArm_${arm_type}HW</plugin>
            <param name="can_interface">${can_interface}</param>
            <param name="arm_prefix">${arm_prefix}</param>
            <param name="hand">${hand}</param>
            <param name="can_fd">${can_fd}</param>
          </xacro:if>
        </hardware>

      <xacro:macro name="configure_joint" params="joint_name initial_position kp:=2000.0 kd:=100.0 ki:=10.0">
        <joint name="${joint_name}">
          <!-- MuJoCo PID parameters (must be at joint level, not under command_interface)
               Kp: Stiffness | Kd: Damping | Ki: Gravity compensation -->
          <xacro:if value="${use_mujoco}">
            <param name="position_kp">${kp}</param>
            <param name="position_kd">${kd}</param>
            <param name="position_ki">${ki}</param>
            <!-- velocity_kp acts as damping gain (Kd) in MIT mode -->
            <param name="velocity_kp">${kd}</param>
            <param name="velocity_kd">0.0</param>
            <param name="velocity_ki">0.0</param>
          </xacro:if>

          <!-- Command Interfaces -->
          <!-- ALWAYS expose standard interface names (same for real, fake, and MuJoCo) -->
          <command_interface name="position"/>
          <command_interface name="velocity"/>
          <command_interface name="effort"/>

          <!-- State Interfaces -->
          <state_interface name="position">
            <param name="initial_value">${initial_position}</param>
          </state_interface>

          <state_interface name="velocity">
            <param name="initial_value">0.0</param>
          </state_interface>

          <state_interface name="effort">
            <param name="initial_value">0.0</param>
          </state_interface>

        </joint>
      </xacro:macro>

      <!-- PID gains: Reduced for RNEA controller (feedforward-dominant control) -->
      <!-- These gains are used by mujoco_system in MIT mode (when effort interface is claimed) -->
      <!-- Initial positions: Canonical zero pose (all joints at 0.0 rad) -->
      <!-- Strategy: Low hardware PD gains + high RNEA feedforward = smooth, accurate control -->
      <!-- Hardware PD provides only small corrections; RNEA provides main control authority -->
      <!-- Kp: 5-10x reduction from previous values (was 5000-8000, now 500-1000) -->
      <!-- Kd: 5-10x reduction from previous values (was 220-300, now 30-50) -->
      <xacro:configure_joint joint_name="openarm_${arm_prefix}joint1" initial_position="0.0" kp="800.0" kd="40.0" ki="0.0"/>
      <xacro:configure_joint joint_name="openarm_${arm_prefix}joint2" initial_position="0.0" kp="1000.0" kd="50.0" ki="0.0"/>
      <xacro:configure_joint joint_name="openarm_${arm_prefix}joint3" initial_position="0.0" kp="800.0" kd="40.0" ki="0.0"/>
      <xacro:configure_joint joint_name="openarm_${arm_prefix}joint4" initial_position="0.0" kp="1000.0" kd="50.0" ki="0.0"/>
      <xacro:configure_joint joint_name="openarm_${arm_prefix}joint5" initial_position="0.0" kp="300.0" kd="15.0" ki="0.0"/>
      <xacro:configure_joint joint_name="openarm_${arm_prefix}joint6" initial_position="0.0" kp="200.0" kd="10.0" ki="0.0"/>
      <xacro:configure_joint joint_name="openarm_${arm_prefix}joint7" initial_position="0.0" kp="200.0" kd="10.0" ki="0.0"/>

      <xacro:if value="${hand}">
        <xacro:configure_joint joint_name="openarm_${arm_prefix}finger_joint1" initial_position="0.0" />
      </xacro:if>

    </ros2_control>

  </xacro:macro>


</robot>
